# apps/api
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:6006

# apps/web: where the server reads the API. Defaults to http://localhost:4000; set it in deployments.
API_URL=http://localhost:4000

# apps/api: Postgres. Neon, or local (infra/docker-compose.yml)
DATABASE_URL=postgres://family:family@localhost:5432/family

# apps/api: secret Vercel Cron sends to job routes. Leave unset locally.
# CRON_SECRET=
